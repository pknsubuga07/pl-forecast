# No API keys are required: every data source used by this project is public.
# All variables below are optional overrides.

# Where the SQLite database lives (default: data/epl.sqlite)
# EPL_DB_PATH=data/epl.sqlite

# Where downloaded files and the ledger live (default: data/)
# EPL_DATA_DIR=data

# Where the dashboard JSON is written (default: web/public/data)
# EPL_WEB_DATA_DIR=web/public/data

# User-Agent sent to the data sources. Please keep it identifiable and polite.
# EPL_USER_AGENT=epl-predictor/1.0 (personal, educational project; you@example.com)
